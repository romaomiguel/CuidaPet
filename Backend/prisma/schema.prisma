generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

enum Role {
  tutor
  petsitter
  admin
  partner
}

enum ServiceType {
  hospedagem
  passeio
  adestramento
  banho_e_tosa
  visita
  creche
}

enum PetSpecies {
  cachorro
  gato
  ave
  roedor
  reptil
  outro
}

enum BookingStatus {
  pending
  accepted
  declined
  cancelled
  completed
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  phone     String?
  cpf       String?  @unique
  avatar    String?
  bio       String?
  role      Role
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // Relacionamentos
  pets             Pet[]
  petsitterProfile PetsitterProfile?
  partnerProfile   PartnerProfile?

  bookingsAsTutor     Booking[] @relation("TutorBookings")
  bookingsAsPetsitter Booking[] @relation("PetsitterBookings")

  reviewsGiven    Review[] @relation("TutorReviews")
  reviewsReceived Review[] @relation("PetsitterReviews")

  refreshTokens RefreshToken[]
  chatMessages  ChatMessage[]
}

model PetsitterProfile {
  id           String        @id @default(uuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio          String
  services     ServiceType[]
  pricePerHour Float
  location     String
  city         String
  state        String
  rating       Float         @default(0)
  totalReviews Int           @default(0)
  scheduleConfig Json?        // { "Segunda": { "enabled": true, "start": "08:00", "end": "17:00" }, ... }
  isAvailable  Boolean       @default(true)
  photos       String[]
  pricingConfig Json?
  capacityPerDay Int         @default(1)
  status         String      @default("pending") // pending, approved, rejected
  identityProof  String?
  addressProof   String?
  acceptedSpecies PetSpecies[]
  offersLocationSharing Boolean @default(false)
  hasAirConditioning    Boolean @default(false)
  homeType              String? // "casa" | "apartamento"
  hasBackyard           Boolean @default(false)
  walkSchedule          String? // "manha" | "noite" — horário preferido de passeio
}

enum PartnerType {
  clinica
  petshop
}

model PartnerProfile {
  id              String        @id @default(uuid())
  userId          String        @unique
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            PartnerType
  businessName    String
  cnpj            String?       @unique
  address         String
  city            String
  state           String
  servicesOffered ServiceType[]
  createdAt       DateTime      @default(now())
}

model Pet {
  id        String     @id @default(uuid())
  tutorId   String
  tutor     User       @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  name      String
  species   PetSpecies
  breed     String?
  age       Int
  weight    Float?
  notes     String?
  energyLevel          String? // "baixo" | "medio" | "alto"
  socialLevel          String? // "exclusivo" | "sociavel"
  medicalRestrictions  String?
  feedingInstructions  String?
  photo     String?
  createdAt DateTime   @default(now())

  bookings Booking[]
}

model Booking {
  id          String        @id @default(uuid())
  tutorId     String
  tutor       User          @relation("TutorBookings", fields: [tutorId], references: [id], onDelete: Cascade)
  petsitterId String
  petsitter   User          @relation("PetsitterBookings", fields: [petsitterId], references: [id], onDelete: Cascade)
  pets        Pet[]
  service     ServiceType
  startDate   DateTime
  endDate     DateTime
  status      BookingStatus @default(pending)
  acceptedAt  DateTime?
  completedAt DateTime?
  totalPrice  Float
  notes       String?
  createdAt   DateTime      @default(now())

  reviews      Review[]
  chatMessages ChatMessage[]
  locationCheckIns LocationCheckIn[]
}

model Review {
  id          String   @id @default(uuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tutorId     String
  tutor       User     @relation("TutorReviews", fields: [tutorId], references: [id], onDelete: Cascade)
  petsitterId String
  petsitter   User     @relation("PetsitterReviews", fields: [petsitterId], references: [id], onDelete: Cascade)
  rating      Int
  comment     String?
  tags        String[] @default([])
  createdAt   DateTime @default(now())

  @@unique([bookingId, tutorId])
}

model ChatMessage {
  id        String    @id @default(uuid())
  bookingId String
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  // Nulo = mensagem de sistema (ex: aviso automático de "conversa iniciada" no aceite).
  senderId  String?
  sender    User?     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content   String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([bookingId, createdAt])
}

model LocationCheckIn {
  id        String   @id @default(uuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())

  @@index([bookingId, createdAt])
}

model SupportMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  contact   String?
  question  String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([resolved, createdAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([userId])
}
