# Copie este arquivo para .env e preencha os valores reais.
# Nenhum valor aqui é real — são só os nomes das variáveis que o backend espera.

# --- Banco de dados (Supabase Postgres) — OBRIGATÓRIAS ---
# Pooler em transaction mode (porta 6543, pgbouncer=true) — usada em runtime pelo app.
DATABASE_URL=
# Pooler em session mode (porta 5432) — usada pelo Prisma CLI (generate/migrate).
DIRECT_URL=

# --- Auth — OBRIGATÓRIA ---
JWT_SECRET=

# --- Supabase Storage — OBRIGATÓRIAS ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- CORS — recomendada em produção (default é lista de localhost, só serve pra dev) ---
# Lista de origens permitidas separadas por vírgula, sem espaço/barra final. Ex:
# CORS_ORIGIN=https://seu-app.vercel.app
CORS_ORIGIN=

# --- Ambiente — crítica em produção (habilita cookie Secure/SameSite=None e desliga o Swagger) ---
NODE_ENV=

# --- Opcionais (têm default no código) ---
PORT=
ACCESS_TOKEN_TTL=
REFRESH_TOKEN_TTL_DAYS=
